# 本地 MySQL 凭证模板：复制为 .env.local 后填入真实值
#   cp .env.local.example .env.local
# .env.local 已被 .gitignore 排除，真实凭证不会进入仓库。
#
# createDatabaseIfNotExist=true 让驱动尝试在库不存在时自动创建，
# 但部分版本/权限下不生效，仍建议手工执行：
#   CREATE DATABASE hr_onboarding DEFAULT CHARSET utf8mb4 COLLATE utf8mb4_general_ci;

DB_URL=jdbc:mysql://127.0.0.1:3306/hr_onboarding?useUnicode=true&characterEncoding=utf8&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=在此填入你的MySQL 密码